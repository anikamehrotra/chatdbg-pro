# ChatDBGPro environment template.
# Copy to `.env` (which is gitignored) and fill in real values.

# --- Model providers ---------------------------------------------------------

# Required for every model run. OpenRouter fronts all eight evaluated models
# (GPT-5.5, GPT-4o, Claude Sonnet 4.5, Grok 4, Gemini 2.5 Flash, Qwen3 30B,
# Nemotron 3 Nano 30B, Llama 3.1 8B). Get a key at https://openrouter.ai.
OPENROUTER_API_KEY=

# Required only for the LLM judge (bench/judge.py). The paper uses
# openai/gpt-4o as the judge; provide an OpenAI key if you want to re-judge
# from scratch. If you only need to regenerate figures from the shipped
# score.json files, you can leave this empty.
OPENAI_API_KEY=

# --- ChatDBG safety / behavior toggles --------------------------------------

# When set, ChatDBG bypasses its built-in command allow-list (used by T3 to
# enforce gdb-only). Required for the Tier-3 ablation surface; otherwise
# leave unset.
# CHATDBG_UNSAFE=1

# Override the model used by the in-debugger LLM assistant (rarely needed —
# the orchestrator sets this per-cell).
# CHATDBG_MODEL=openrouter/openai/gpt-4o
